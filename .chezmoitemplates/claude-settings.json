{
  "env": {
    "DISABLE_TELEMETRY": "1",
    "IS_DEMO": "1"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Read",
      "Write",
      "Edit",
      "Read(~/.zshrc)",
      "Bash(git:*)",
      "Bash(ls:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(wc:*)",
      "Bash(xargs:*)",
      "Bash(npm:*)",
      "Bash(pnpm:*)",
      "Bash(gh issue list*)",
      "Bash(gh issue view*)",
      "Bash(gh issue create*)",
      "Bash(gh issue edit*)",
      "Bash(gh issue comment*)",
      "Bash(gh issue close*)",
      "Bash(gh issue reopen*)",
      "Bash(bash /Users/mukit/.claude/statusline-command.sh)",
      "Bash(bash ~/.claude/statusline-command.sh)",
      "Bash(echo \"---EXIT: $?---\")",
      "Bash(chmod +x /Users/mukit/.claude/statusline.sh)",
      "Bash(/Users/mukit/.claude/statusline.sh)",
      "Bash(python3 -c \"import sys,json; d=json.load\\(sys.stdin\\); print\\(json.dumps\\(d.get\\('statusLine'\\),indent=2\\)\\)\")",
      "Bash(echo \"[exit $?]\")",
      "Bash(bash /Users/mukit/.claude/statusline.sh)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./**/.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./.env.development)",
      "Read(./.env.production)",
      "Read(./.env.staging)",
      "Read(./.env.test)",
      "Bash(gh issue delete*)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus[1m]",
  "hooks": {
    "Notification": [
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.local/bin/agent-hook\" claude Notification permission_prompt",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.local/bin/agent-hook\" claude Notification idle_prompt",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "agent_needs_input",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.local/bin/agent-hook\" claude Notification agent_needs_input",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "agent_completed",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.local/bin/agent-hook\" claude Notification agent_completed",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "auth_success|elicitation_dialog|elicitation_url_dialog|elicitation_complete|elicitation_response",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.local/bin/agent-hook\" claude Notification",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.local/bin/agent-hook\" claude PreToolUse",
            "timeout": 10,
            "statusMessage": "Checking rm target safety"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.local/bin/agent-hook\" claude Stop",
            "timeout": 15,
            "statusMessage": "Cleaning up worktree dev/test ports"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "effortLevel": "high",
  "theme": "dark"
}
