if [[ "$OSTYPE" == "darwin"* ]]; then

  # Setup yazi file manager alias
  function y() {
    local tmp="$(mktemp -t "yazi-cwd.XXXXXX")" cwd
    yazi "$@" --cwd-file="$tmp"
    if cwd="$(command cat -- "$tmp")" && [ -n "$cwd" ] && [ "$cwd" != "$PWD" ]; then
      builtin cd -- "$cwd"
    fi
    rm -f -- "$tmp"
  }


  # pnpm
  export PNPM_HOME="$HOME/Library/pnpm"
  path_prepend "$PNPM_HOME/bin"
  # pnpm end

  # Use the 1Password SSH agent. `~` does not expand inside quotes, so use $HOME.
  export SSH_AUTH_SOCK="$HOME/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
fi

# Add sbin folder to path
path_prepend "/usr/local/sbin"

# Add user-local bin to path (uv/pipx installed executables, agent-hook, rm-guard)
path_prepend "$HOME/.local/bin"

# Google Cloud SDK path and completion. Homebrew on Apple Silicon installs the
# SDK under /opt/homebrew; the Intel prefix is the fallback.
for _gcloud_sdk in /opt/homebrew/share/google-cloud-sdk /usr/local/share/google-cloud-sdk; do
  if [ -f "$_gcloud_sdk/path.zsh.inc" ]; then
    . "$_gcloud_sdk/path.zsh.inc"
    [ -f "$_gcloud_sdk/completion.zsh.inc" ] && . "$_gcloud_sdk/completion.zsh.inc"
    break
  fi
done
unset _gcloud_sdk

# Add by Antigravity
