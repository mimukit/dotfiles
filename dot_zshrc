# Load brew tools to shell
if [[ -f "/opt/homebrew/bin/brew" ]] then
  eval "$(/opt/homebrew/bin/brew shellenv)"
fi

# Prepend a directory to PATH once, and only when the directory exists.
# Re-sourcing this file therefore never grows or duplicates PATH.
path_prepend() {
  [[ -d "$1" ]] || return 0
  path=("$1" ${path:#$1})
}

