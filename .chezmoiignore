**/.DS_Store

# repository files, not dotfiles. Anything at the source root that does not
# start with a dot becomes a target: chezmoi was applying this repo's README to
# ~/README.md, and would have created ~/docs from the plan and QA documents the
# agent skills write here.
README.md
docs

# editor/app scratch + state
**/*.tmp
.config/zed/.tmp*
**/ui-state.yml

# binary DB / lock noise
.config/zed/prompts/prompts-library-db.*

# local-only backups
.config/raycast/settings-backup.rayconfig

# yazi flavors — yazi's own package manager (`ya pkg`) installs and rewrites
# these, pinned by rev and hash in .config/yazi/package.toml, which chezmoi does
# track. Two writers on the same files made `chezmoi apply` stop and ask whether
# the flavor had changed since chezmoi last wrote it. Restore them on a new
# machine with `ya pkg install`.
.config/yazi/flavors

# Orca — the app installs these hook scripts itself and rewrites them on every
# upgrade, exactly like the vendor entries in ~/.claude/settings.json. Ours live
# in ~/.local/bin/agent-hook instead. Never track them.
.orca/agent-hooks/**

# Orca's app-support dir is runtime state: sqlite orchestration DB, cookies,
# Chromium caches, terminal history, device-pairing tokens and e2ee key material.
# Only the settings blob is managed, and only a curated slice of it, merged in by
# a modify_ script. These patterns are a backstop: `chezmoi add` bypasses
# .chezmoiignore, but anything that does slip into the source here will never be
# applied to a target. Do not `chezmoi add` this directory.
# Ignore level by level with a single `*` rather than `**`: an excluded directory
# is never descended into, so the path down to orca-data.json has to stay open.
Library/Application Support/orca/*
!Library/Application Support/orca/profiles
Library/Application Support/orca/profiles/*
!Library/Application Support/orca/profiles/local-default
Library/Application Support/orca/profiles/local-default/*
!Library/Application Support/orca/profiles/local-default/orca-data.json

# secrets / key material — never let chezmoi manage these (belongs in
# 1Password / Keychain / ~/.ssh, not the source tree)
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.ppk
**/id_rsa
**/id_ed25519
**/id_ecdsa
**/id_dsa
**/*_rsa
**/*_ed25519
**/*_ecdsa
**/.env
**/.env.*
**/*.secrets
