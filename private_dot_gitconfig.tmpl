[user]
    name = Mukitul Islam Mukit
    email = hellomukit@gmail.com
    signingkey = ~/.ssh/github_mimukit
[commit]
    gpgsign = true
[merge]
    ff = false
[init]
    defaultBranch = main
[pull]
    ff = only
[core]
    excludesfile = ~/.config/git/.gitignore_global
    ignoreCase = false
[credential "https://github.com"]
    helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
    helper = !/opt/homebrew/bin/gh auth git-credential
[gpg]
    format = ssh
[alias]
	  lg = log --color --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit
[gpg "ssh"]
	allowedSignersFile = {{ .chezmoi.homeDir }}/.ssh/allowed_signers
	; Wrapper that clears SSH_AUTH_SOCK, so ssh-keygen signs with the key file
	; instead of asking the 1Password agent for Touch ID on every commit.
	program = {{ .chezmoi.homeDir }}/.local/bin/git-ssh-sign
; Machine-local git settings, kept out of this repo. Last include wins, so
; anything here overrides the sections above.
;
; This exists for keys a tool generates per machine. coderabbit.machineId was
; the first: a per-install id, the same class of value as Orca's
; telemetry.installId, which this repo already refuses to track.
;
; Caveat: `git config --global` always writes to ~/.gitconfig, never to an
; include. If a tool regenerates such a key it lands above this line, and the
; next `czs` offers it back to the source. Reject it in the diff and move the
; value here.
[include]
	path = ~/.gitconfig.local
