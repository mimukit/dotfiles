# Added by OrbStack: 'orb' SSH host for Linux machines
# This only works if it's at the top of ssh_config (before any Host blocks).
# This won't be added again if you remove it.
Include ~/.orbstack/ssh/config
Include ~/.ssh/1Password/config


# GitHub: sign/push using the local key file directly, bypassing the
# 1Password agent so no Touch ID / fingerprint prompt is needed (e.g. remote
# sessions, or unattended agents like Claude Code and Codex).
# ssh.github.com is the port-443 fallback endpoint; gist.github.com serves gists.
# No HostName here, so each pattern keeps its own address.
# Placed before "Host *" because ssh uses the first matching value per keyword.
Host github.com ssh.github.com gist.github.com
	User git
	IdentitiesOnly yes
	IdentityAgent none
	IdentityFile ~/.ssh/github_mimukit

Host brainaloy-ovh-ts
	User ubuntu
	HostName brainaloy-ovh
  IdentitiesOnly yes

Host devaloy-ovh-ts
	User dev
	HostName devaloy-ovh
  IdentitiesOnly yes

Host *
	IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
