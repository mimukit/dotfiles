#!/usr/bin/env bash
# agent-hook — one dispatcher for the hooks we own, shared by Claude Code and
# Codex CLI (chezmoi: private_dot_local/bin/executable_agent-hook).
#
# Our hook logic used to be inline shell in ~/.claude/settings.json and
# ~/.codex/hooks.json — a copy per event, per agent, quietly drifting apart.
# Codex's notifier checked two suppression vars where Claude's checked four, so
# Codex kept toasting inside herdr panes. Everything now routes through here:
#
#     bash "$HOME/.local/bin/agent-hook" <agent> <Event>
#
# with the hook JSON payload on stdin. One short command per event, and the
# behaviour lives in one readable place instead of being duplicated per agent.
#
# Scope — this owns OUR hooks only, three events:
#   PreToolUse     rm-guard delete check
#   Notification   desktop toast, reason taken from the settings matcher
#   Stop           desktop toast + worktree port cleanup
#
# A toast names the repo and branch, carries a reason, and focuses the pane that
# sent it when you click it. See the notification helpers below feat_notify.
#
# Vendor hooks are deliberately NOT routed through here. Orca and herdr install
# and maintain their own entries alongside ours, and both are careful about it:
# Orca's applyManagedHooks() strips only commands matching its own script name
# and appends its entry after ours, so the two coexist without either clobbering
# the other. Wrapping their relays here would mean Orca no longer recognises its
# own entry, re-adds it, and every hook fires twice. Leave them alone.
#
# Design rules (all four are load-bearing — see the notes at each site)
#   1. Only feat_rm_guard writes to stdout. Anything else leaking bytes would
#      corrupt the permission decision the agent parses. The notify_* helpers
#      print their result, but every call site wraps them in $(...), so those
#      bytes never reach the real stdout.
#   2. rm-guard fails CLOSED; every other feature fails open and never breaks a
#      turn. Hence no `set -e` — one dead feature must not abort the dispatcher.
#   3. stdin is drained exactly once into $payload, then piped to each consumer.
#   4. The script always exits 0. A non-zero exit is a hook error to the agent.

RM_GUARD="$HOME/.local/bin/rm-guard"
PORT_CLEANUP="$HOME/.claude/hooks/cleanup-worktree-ports.sh"

# Suppress desktop toasts when a supervising UI already surfaces agent state.
# Claude used to check all four of these and Codex only the first two — one list
# now, both agents. ORCA_PANE_KEY is pane identity rather than hook plumbing, so
# it stays set even if Orca's "Agent status hooks" setting is ever turned off.
#
# Paseo runs an agent two ways and each gets its own identity var, so both are
# listed: PASEO_TERMINAL_ID for a shell in a Paseo terminal pane, PASEO_AGENT_ID
# for a session Paseo drives itself through the SDK. Only the terminal case has
# Paseo hook entries in settings.json (they are gated on PASEO_TERMINAL_ID);
# the agent case reports state over its own client. Both end in a native toast,
# so ours is a duplicate either way. PASEO_CLI is the bundled binary path rather
# than session identity — not a suppression signal.
NOTIFY_SUPPRESS_VARS="ORCA_PANE_KEY ORCA_AGENT_HOOK_PORT HERDR_ENV SUPERSET_HOME_DIR PASEO_TERMINAL_ID PASEO_AGENT_ID"

# --- features ---------------------------------------------------------------

# The one function allowed to write to stdout. rm-guard prints a permission
# decision for deletes and nothing at all otherwise, letting non-deletes fall
# through to the agent's normal permission flow.
feat_rm_guard() {
  local tool
  # Claude scopes this entry to matcher "Bash" in settings.json. Codex has no
  # matcher support, so the tool check is repeated here — and Codex payloads may
  # not name a tool at all, so an empty name passes through to rm-guard, which
  # finds no command and prints nothing.
  tool=$(payload_get '.tool_name // .tool_input.tool_name // ""')
  case "$tool" in
    Bash | bash | Shell | shell | "") ;;
    *) return 0 ;;
  esac

  if [ -r "$RM_GUARD" ]; then
    printf '%s' "$payload" | bash "$RM_GUARD" 2>/dev/null
    return 0
  fi

  # Fail closed: with the guard gone, block anything that looks like a delete.
  if printf '%s' "$payload" | grep -Eq '(^|[^[:alnum:]_])rm([^[:alnum:]_]|$)'; then
    printf '%s\n' '{"hookSpecificOutput":{"hookEventName":"PreToolUse","permissionDecision":"deny","permissionDecisionReason":"rm-guard script missing; blocking rm for safety"}}'
  fi
  return 0
}

feat_notify() {
  local body="$1" title subtitle group focus var
  for var in $NOTIFY_SUPPRESS_VARS; do
    eval "[ -n \"\${$var:-}\" ]" && return 0
  done
  command -v terminal-notifier >/dev/null 2>&1 || return 0
  case "$AGENT" in
    codex) title="Codex" ;;
    *) title="Claude Code" ;;
  esac

  subtitle=$(notify_subtitle)

  # One live banner per session. terminal-notifier removes an older toast that
  # carries the same group, so a Stop replaces the Notification it follows
  # instead of stacking a second row in Notification Center.
  group=$(payload_get '.session_id // ""')
  [ -n "$group" ] || group="$PROJECT_DIR"

  # Omit -execute entirely when nothing identifies the session. An empty string
  # would still register a click handler that runs nothing.
  focus=$(notify_focus_cmd)
  if [ -n "$focus" ]; then
    terminal-notifier -title "$title" -subtitle "$subtitle" -message "$body" \
      -group "$group" -execute "$focus" >/dev/null 2>&1
  else
    terminal-notifier -title "$title" -subtitle "$subtitle" -message "$body" \
      -group "$group" >/dev/null 2>&1
  fi
  return 0
}

# --- notification helpers ---------------------------------------------------
#
# Each helper prints its result and every call site wraps it in $(...), which is
# what keeps design rule 1 true.

# "chezmoi · main", or the directory name alone outside a git checkout.
notify_subtitle() {
  local repo branch
  repo=$(basename "$PROJECT_DIR")
  branch=$(git -C "$PROJECT_DIR" symbolic-ref --short HEAD 2>/dev/null)
  printf '%s%s' "$repo" "${branch:+ · $branch}"
}

# Claude names the notification type in the settings matcher, and each entry
# passes that name as $3. Codex hook entries take no matcher, so $REASON is
# empty there and every Codex toast falls through to the generic text.
notify_reason() {
  case "$REASON" in
    permission_prompt) printf 'Needs permission' ;;
    idle_prompt) printf 'Waiting for you' ;;
    agent_needs_input) printf 'Needs input' ;;
    agent_completed) printf 'Agent finished' ;;
    *) printf 'Awaiting your input' ;;
  esac
}

# The agent's closing line, flattened to one line and cut to 80 characters.
# Claude documents last_assistant_message as the cheap alternative to reading
# transcript_path, which would mean parsing JSONL inside a 10s hook.
notify_stop_body() {
  local msg
  msg=$(payload_get '.last_assistant_message // ""' |
    tr '\n\t' '  ' | sed 's/  */ /g; s/^ //; s/ $//')
  [ -n "$msg" ] || {
    printf 'Task completed'
    return 0
  }
  if [ "${#msg}" -gt 80 ]; then
    printf '%.77s...' "$msg"
  else
    printf '%s' "$msg"
  fi
}

# The macOS application to raise on click. TERM_PROGRAM names the terminal that
# started the agent, and a hook inherits the agent's environment.
notify_terminal_app() {
  case "${TERM_PROGRAM:-}" in
    ghostty | Ghostty) printf 'Ghostty' ;;
    WezTerm) printf 'WezTerm' ;;
    Apple_Terminal) printf 'Terminal' ;;
    vscode) printf 'Code' ;;
    *) printf 'iTerm' ;;
  esac
}

# Prints the shell command terminal-notifier runs when you click the banner, or
# nothing when the session gives no way back. terminal-notifier registers the
# command and exits, so this costs the hook no wall time.
notify_focus_cmd() {
  local app sess win pane uuid line out
  app=$(notify_terminal_app)

  # tmux wins. $TMUX_PANE names the pane that started the agent, so the click
  # lands on that pane even when the client currently shows another session.
  if [ -n "${TMUX:-}" ] && [ -n "${TMUX_PANE:-}" ] &&
    command -v tmux >/dev/null 2>&1; then
    sess=$(tmux display-message -p -t "$TMUX_PANE" '#{session_name}' 2>/dev/null)
    win=$(tmux display-message -p -t "$TMUX_PANE" '#{window_index}' 2>/dev/null)
    pane=$(tmux display-message -p -t "$TMUX_PANE" '#{pane_index}' 2>/dev/null)
    if [ -n "$sess" ] && [ -n "$win" ] && [ -n "$pane" ]; then
      # %q quotes each target, so a session name with a space survives the trip
      # through terminal-notifier's shell. The \\; reaches tmux as a literal ;
      # which is how tmux chains commands in one invocation.
      printf 'tmux switch-client -t %q \\; select-window -t %q \\; select-pane -t %q; open -a %q' \
        "$sess" "$sess:$win" "$sess:$win.$pane" "$app"
      return 0
    fi
  fi

  # Bare iTerm2. ITERM_SESSION_ID reads "w0t1p0:UUID" and iTerm2's AppleScript
  # `id` property is the UUID half.
  if [ -n "${ITERM_SESSION_ID:-}" ]; then
    uuid=${ITERM_SESSION_ID#*:}
    out=""
    for line in \
      'tell application "iTerm2"' \
      'activate' \
      'repeat with w in windows' \
      'repeat with t in tabs of w' \
      'repeat with s in sessions of t' \
      "if id of s is \"$uuid\" then" \
      'select w' \
      'select t' \
      'select s' \
      'end if' \
      'end repeat' \
      'end repeat' \
      'end repeat' \
      'end tell'; do
      out="$out -e $(printf '%q' "$line")"
    done
    printf 'osascript%s' "$out"
    return 0
  fi

  # Nothing identifies the session, so raise the terminal and stop there. An
  # unknown TERM_PROGRAM means we cannot even name an app, so print nothing.
  [ -n "${TERM_PROGRAM:-}" ] && printf 'open -a %q' "$app"
  return 0
}

# Kills dev/test servers left listening in an ephemeral Orca worktree. The
# script self-limits to ~/orca/workspaces/*, so it never touches a dev server in
# a regular checkout. Claude-only before this; Codex gets it too now.
feat_port_cleanup() {
  [ -r "$PORT_CLEANUP" ] || return 0
  printf '%s' "$payload" | AGENT_PROJECT_DIR="$PROJECT_DIR" sh "$PORT_CLEANUP" >/dev/null 2>&1
  return 0
}

# --- helpers ----------------------------------------------------------------

payload_get() {
  [ -n "$HAVE_JQ" ] || return 0
  printf '%s' "$payload" | jq -r "$1" 2>/dev/null
}

usage() {
  cat <<'EOF'
agent-hook — central hook dispatcher for Claude Code and Codex CLI

  agent-hook <claude|codex> <Event> [reason]
                                      dispatch a hook (payload JSON on stdin)
  agent-hook --help                   this message

Handled events: PreToolUse, Notification, Stop.
[reason] repeats the settings matcher on a Notification entry, one of
permission_prompt, idle_prompt, agent_needs_input or agent_completed. Any other
value, and any missing value, uses the generic text.
Orca and herdr manage their own hook entries separately — by design.
EOF
}

# --- main -------------------------------------------------------------------

case "${1:-}" in
  -h | --help | help | "")
    usage
    exit 0
    ;;
esac

AGENT="$1"
EVENT="${2:-}"
# Claude's Notification entries each carry one matcher and repeat its value
# here. Every other event and every Codex entry leaves this empty.
REASON="${3:-}"

HAVE_JQ=""
command -v jq >/dev/null 2>&1 && HAVE_JQ=1

# Drain stdin once, before anything can exit early. Leaving the pipe unread
# risks SIGPIPE or a blocked agent (design rule 3).
payload=$(cat)

PROJECT_DIR=$(payload_get '.cwd // .tool_input.cwd // ""')
[ -n "$PROJECT_DIR" ] || PROJECT_DIR="${CLAUDE_PROJECT_DIR:-${CODEX_PROJECT_DIR:-$PWD}}"

case "$EVENT" in
  PreToolUse)
    feat_rm_guard
    ;;
  Notification)
    feat_notify "$(notify_reason)"
    ;;
  Stop)
    feat_notify "$(notify_stop_body)"
    feat_port_cleanup
    ;;
esac

exit 0
